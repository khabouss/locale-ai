{
  "name": "locale-ai",
  "version": "0.7.17",
  "description": "Translate your i18n locale files locally on CPU. Free, offline, no API keys.",
  "author": "Taha KHABOUSS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khabouss/locale-ai.git"
  },
  "homepage": "https://github.com/khabouss/locale-ai#readme",
  "bugs": {
    "url": "https://github.com/khabouss/locale-ai/issues"
  },
  "type": "module",
  "bin": {
    "locale-ai": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/convert-marian.py",
    "scripts/trim-onnxruntime.cjs"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "test:e2e": "LOCALE_AI_E2E=1 node --test test/e2e.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "node scripts/trim-onnxruntime.cjs"
  },
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "translation",
    "machine-translation",
    "locales",
    "i18next",
    "offline",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "onnxruntime-node": "^1.30.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "onnxruntime-node": true
  }
}
